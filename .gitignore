# Test set: never commit (only its hash in data/test/TESTSET_SHA256)
data/test/*
!data/test/README.md
!data/test/TESTSET_SHA256

# Real (anonymized) messages and notes: never commit
data/private/*
!data/private/README.md

# Model weights
*.gguf
*.bin
*.safetensors
models/

# Secrets
.env
*.key
secrets.*

# Large raw run outputs (commit summaries only)
results/raw/

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# Xcode / iOS
ios/**/build/
ios/**/DerivedData/
ios/**/xcuserdata/
*.xcuserstate
ios/**/Pods/
*.ipa
*.dSYM.zip

# OS
.DS_Store
Thumbs.db

# LaTeX build files
*.aux
*.log
*.out
*.synctex.gz
ios/vendor/

# Generated by XcodeGen (ios/scripts/make_project.sh)
ios/PrivateEdge/*.xcodeproj/
ios/PrivateEdge/.project.nomodel.yml
ios/PrivateEdge/Sources/Info.plist
ios/PrivateEdge/Sources/PrivateEdge.entitlements

# llama.cpp XCFramework (download with ios/fetch_llama.sh)
ios/PrivateEdgeCore/Frameworks/
# iOS replay bundle exported from configs (harness/export_ios_bundle.py)
ios/App/Bundle/
# SwiftPM build output
ios/**/.build/
ios/**/.swiftpm/
# Generated by xcodegen from ios/App/project.yml
ios/App/PrivateEdge.xcodeproj/
