# Calendar/actions output: exactly one JSON object, one of the five actions in prompts/calendar_v0.txt.
# The grammar fixes the shape and formats (ISO 8601 start with offset, YYYY-MM-DD date, 2-place amount,
# ISO 4217 currency, allowed clarify fields). It cannot check that values are RIGHT; that is C3's job.
# Pydantic (harness/calendar_schema.py) validates every output again in code. Grammars cannot forbid
# repeated clarify fields; the schema drops repeats.
root      ::= "{" ws ( event | reminder | expense | none | clarify ) ws "}"

event     ::= ("\"action\":" ws "\"event\"" sep "\"title\":" ws text sep "\"start\":" ws start sep
              "\"duration_min\":" ws minutes sep "\"spans\":" ws "{" ws
              "\"date\":" ws span sep "\"time\":" ws span sep "\"duration\":" ws span sep "\"title\":" ws span ws "}" )
reminder  ::= ("\"action\":" ws "\"reminder\"" sep "\"title\":" ws text sep "\"start\":" ws start sep
              "\"spans\":" ws "{" ws "\"date\":" ws span sep "\"time\":" ws span sep "\"title\":" ws span ws "}" )
expense   ::= ("\"action\":" ws "\"expense\"" sep "\"amount\":" ws amount sep "\"currency\":" ws currency sep
              "\"description\":" ws text sep "\"date\":" ws day sep
              "\"spans\":" ws "{" ws "\"amount\":" ws span sep "\"date\":" ws span sep "\"description\":" ws span ws "}" )
none      ::= "\"action\":" ws "\"none\""
clarify   ::= "\"action\":" ws "\"clarify\"" sep "\"fields\":" ws "[" ws field ( sep field ){0,2} ws "]"

field     ::= "\"date\"" | "\"start_time\"" | "\"ampm\"" | "\"which_event\"" | "\"conflict\"" | "\"invalid_time\"" | "\"amount\""
start     ::= "\"" [0-9]{4} "-" [0-1] [0-9] "-" [0-3] [0-9] "T" [0-2] [0-9] ":" [0-5] [0-9] ":" [0-5] [0-9] [+-] [0-1] [0-9] ":" [0-5] [0-9] "\""
day       ::= "\"" [0-9]{4} "-" [0-1] [0-9] "-" [0-3] [0-9] "\""
amount    ::= "\"" [1-9] [0-9]{0,6} "." [0-9]{2} "\"" | "\"0." [0-9]{2} "\""
currency  ::= "\"" [A-Z]{3} "\""
minutes   ::= [1-9] [0-9]{0,3}
span      ::= text | "null"
text      ::= "\"" ( [^"\\\x7F\x00-\x1F] | "\\" ( ["\\/bfnrt] | "u" [0-9a-fA-F]{4} ) ){1,120} "\""
sep       ::= ws "," ws
ws        ::= [ \t\n]{0,2}
